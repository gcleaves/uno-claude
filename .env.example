# Copy to .env and edit. docker compose reads this file automatically.

# Port published on the host. The container always listens on 3001 internally.
UNO_PORT=3001

# 'guest' lets anyone with a room code play. Set to 'keycloak' to require an
# account, and fill in the two variables below.
AUTH_MODE=guest
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=

# Only needed if the UI is served from a different origin than the socket.
CORS_ORIGIN=*

# How long a disconnected player keeps their seat.
RECONNECT_GRACE_SEC=120

# Turn clocks, in seconds. When one runs out the server draws for the player and
# forfeits their turn, so nobody can stall the table. 0 disables that clock.
# The player has no legal play, so the only move is to draw:
FORCED_ACTION_SEC=5
# The player has a real choice of card to make:
TURN_TIMEOUT_SEC=45
# The player is disconnected:
AFK_TURN_SEC=20
# How long an empty room lingers before being reclaimed.
EMPTY_ROOM_TTL_MIN=15

# Games are snapshotted here and restored on boot, so a restart does not end
# them. Set empty to disable persistence.
SNAPSHOT_PATH=/data/rooms.json
# Background save interval; bounds how much play a hard crash can lose.
SNAPSHOT_INTERVAL_SEC=10
# Turn clocks are held this long after a restart, so nobody is forfeited while
# their phone is still reconnecting.
RESUME_GRACE_SEC=30

# --- abuse controls -------------------------------------------------------
# Turn this on ONLY behind a reverse proxy you control. The X-Forwarded-For
# header is forgeable, so trusting it on a directly exposed server lets one
# attacker appear as unlimited clients and defeats every per-client limit.
TRUST_PROXY=1
# Characters in a room code. Six makes guessing a live room impractical.
ROOM_CODE_LENGTH=6
# Live sockets from one address.
MAX_CONNECTIONS_PER_IP=12
# Rooms held on the server at once, across everyone.
MAX_ROOMS=100
# Per client, per minute. Generous for playing, useless for flooding.
ACTIONS_PER_MINUTE=240
CREATES_PER_MINUTE=5
# This one is the anti-guessing limit for room codes.
JOINS_PER_MINUTE=20

# --- logging --------------------------------------------------------------
# Newline-delimited JSON, one event per line, written under the data volume.
# Query it with: duckdb -c "SELECT * FROM read_json_auto('data/logs/*.jsonl')"
LOG_DIR=/data/logs
# debug also records every game action; info is the useful default.
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# --- PostHog --------------------------------------------------------------
# Project API key. Publishable by design (it ships in the browser bundle), so
# it is configuration rather than a secret. Empty disables analytics on both
# the server and the client. Note this is read at BUILD time for the browser.
POSTHOG_KEY=phc_tu6rP9Jud5p5MBHRqLGkdcCGQPCbJWuViGxKBSHGKNtK
# EU Cloud.
POSTHOG_HOST=https://eu.i.posthog.com
# Anything stable and private; salts the hash used for analytics ids.
POSTHOG_SALT=change-me
